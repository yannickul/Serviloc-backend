# Copie ce fichier en .env et remplis toi-même chaque valeur.

# --- Base de données (cf. docker-compose racine du repo) ---
DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# --- Sécurité inter-services ---
INTERNAL_TOKEN=

# --- Email (Resend) ---
# Clé API : https://resend.com → Settings → API Keys
RESEND_API_KEY=
# Expéditeur : sans domaine vérifié, utilise "onboarding@resend.dev"
# (Resend autorise l'envoi vers TON adresse de compte avec cet expéditeur)
EMAIL_FROM=onboarding@resend.dev
EMAIL_FROM_NAME=ServiLoc
